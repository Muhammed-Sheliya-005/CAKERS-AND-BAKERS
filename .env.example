# Example only — change locally and never commit a real .env file.
# This placeholder is not a real credential.
DATABASE_URL=mysql://cakers_user:change-me@127.0.0.1:3306/cakers

# Optional owner identity hint if using a separately provisioned local Manus OAuth project.
# The managed project already supplies its owner identity at runtime.
OWNER_OPEN_ID=

# MANUS_PROJECT_ID, MANUS_JWT_SECRET, MANUS_OAUTH_API_URL,
# MANUS_API_URL and MANUS_API_KEY are platform-managed runtime values.
# Never paste production platform credentials into this example file.
